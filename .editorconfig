# EditorConfig: https://editorconfig.org
# Unifies indentation, line endings and final newlines across file types for
# collaborative editing. Supported natively or via plugin by most editors
# (VS Code, GoLand, Vim, etc.).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go: official gofmt style, tab indentation
[*.go]
indent_style = tab
indent_size = 4

# Shell scripts: 2-space indentation
[*.sh]
indent_size = 2

# YAML / TS / JS: 2-space indentation (VitePress / goreleaser / GitHub Actions)
[*.{yml,yaml,ts,js,json}]
indent_size = 2

# Markdown: keep trailing whitespace (two trailing spaces mean a line break)
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Makefiles must use tabs
[Makefile]
indent_style = tab
