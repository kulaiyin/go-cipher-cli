# Build artifacts
/dist/
/build/

# APT repository generated files (conf/ is config and tracked; dists/pool/ and
# signing keys are build products)
/repo/dists/
/repo/pool/
/repo/*.gpg.key

# VitePress docs build output
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# Node dependencies
/node_modules/

# goreleaser local snapshots
*.snapshot

# Go test/coverage output
*.out
*.test
coverage.txt

# Editor/system files
.idea/
.vscode/
*.swp
.DS_Store
*.bak*

# Dev assistant / session temp files (not version controlled)
.zcode/
.codewhale/
.claude/
# Compiled binary
go-cipher-cli
